# --- Required ---------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_API_MODE=chat_completions

# --- Model ------------------------------------------------------------
# AIRGENT_MODEL=anthropic/claude-sonnet-4.5

# -----------------------------------------------------------------------
# Optional capabilities — everything below defaults to OFF, which keeps
# Airgent a plain pi-agent wrapper. Flip a line on to enable a feature.
# -----------------------------------------------------------------------

# Sandbox for the pi kernel: none | seatbelt (macOS) | docker | landlock (Linux >= 5.13)
#AIRGENT_SANDBOX=seatbelt
# Sandbox tier: read-only | workspace-write (default) | full
#AIRGENT_SANDBOX_MODE=workspace-write
# Allow outbound network inside the sandbox (default: denied)
#AIRGENT_SANDBOX_NETWORK=0
# Docker image used when AIRGENT_SANDBOX=docker
#AIRGENT_SANDBOX_IMAGE=airgent-sandbox:latest

# Skill registry (per-skill enable/disable on top of native discovery)
#AIRGENT_SKILLS_REGISTRY=1

# MCP servers bridge (config defaults to ~/.airgent/mcp.json)
#AIRGENT_MCP=1
#AIRGENT_MCP_CONFIG=/path/to/mcp.json

# Sub-agents (spawn_subagent delegation tool)
#AIRGENT_SUBAGENTS=1
#AIRGENT_SUBAGENTS_MAX_DEPTH=1
#AIRGENT_SUBAGENTS_MODEL=

# Guardrails (tool-call policy; config defaults to ~/.airgent/guardrails.json)
#AIRGENT_GUARDRAILS=1
#AIRGENT_GUARDRAILS_CONFIG=/path/to/guardrails.json

# Permission tiers: read-only | workspace-write (off by default).
# workspace-write confines edits to the workspace and asks before dangerous
# bash commands; ask/deny patterns live in ~/.airgent/permissions.json.
#AIRGENT_PERMISSION_MODE=workspace-write
# Seconds before an unanswered permission prompt is auto-denied
#AIRGENT_PERMISSION_TIMEOUT=600

# Lifecycle hooks (config defaults to ~/.airgent/hooks.json)
# before_run/after_run are Python-side turn hooks; declaring before_tool /
# after_tool entries in the same file additionally deploys the kernel-side
# tool-hook extension (Claude-Code PreToolUse/PostToolUse style).
#AIRGENT_HOOKS=1
#AIRGENT_HOOKS_CONFIG=/path/to/hooks.json

# Cost tracking: record per-run token/cost usage (airgent cost to inspect)
#AIRGENT_COST_TRACKING=1
# Hard spend cap in USD (0 = off); further runs are refused once crossed
#AIRGENT_MAX_BUDGET_USD=0

# Memory upgrades
# Harvest durable facts from user messages automatically
#AIRGENT_MEMORY_AUTO_EXTRACT=1
# Importance halves every N days without access (0 = off)
#AIRGENT_MEMORY_DECAY_DAYS=0
# Letta-style always-in-context core memory blocks
#AIRGENT_MEMORY_CORE_BLOCKS=1
# Skip storing near-duplicate memories
#AIRGENT_MEMORY_DEDUP=1
# Hybrid retrieval: semantic + keyword fusion (needs OPENAI_BASE_URL and
# sqlite-vec via `uv sync --extra memory`; degrades to keyword-only otherwise)
#AIRGENT_MEMORY_EMBEDDINGS=1
#AIRGENT_EMBEDDING_MODEL=text-embedding-3-small

# Stream rules (omp-style time-traveling rules; config defaults to
# ~/.airgent/stream-rules.json with {"rules": [{"pattern", "instruction"}]})
#AIRGENT_STREAM_RULES=1
#AIRGENT_STREAM_RULES_MAX_RETRIES=2

# Observability: persist per-run trace events (query via store/API)
#AIRGENT_TRACING=1
