# --- Required ---------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_API_MODE=chat_completions

# --- Model ------------------------------------------------------------
# AIRGENT_MODEL=anthropic/claude-sonnet-4.5

# -----------------------------------------------------------------------
# Optional capabilities — everything below defaults to OFF, which keeps
# Airgent a plain pi-agent wrapper. Flip a line on to enable a feature.
# -----------------------------------------------------------------------

# Sandbox for the pi kernel: none | seatbelt (macOS) | docker
#AIRGENT_SANDBOX=seatbelt
# Allow outbound network inside the sandbox (default: denied)
#AIRGENT_SANDBOX_NETWORK=0
# Docker image used when AIRGENT_SANDBOX=docker
#AIRGENT_SANDBOX_IMAGE=airgent-sandbox:latest

# Skill registry (per-skill enable/disable on top of native discovery)
#AIRGENT_SKILLS_REGISTRY=1
#AIRGENT_SKILLS_ALLOW_ALL=1

# MCP servers bridge (config defaults to ~/.airgent/mcp.json)
#AIRGENT_MCP=1
#AIRGENT_MCP_CONFIG=/path/to/mcp.json

# Sub-agents (spawn_subagent delegation tool)
#AIRGENT_SUBAGENTS=1
#AIRGENT_SUBAGENTS_MAX_DEPTH=1
#AIRGENT_SUBAGENTS_MODEL=

# Guardrails (tool-call policy; config defaults to ~/.airgent/guardrails.json)
#AIRGENT_GUARDRAILS=1
#AIRGENT_GUARDRAILS_CONFIG=/path/to/guardrails.json

# Lifecycle hooks (config defaults to ~/.airgent/hooks.json)
#AIRGENT_HOOKS=1
#AIRGENT_HOOKS_CONFIG=/path/to/hooks.json

# Memory upgrades
# Harvest durable facts from user messages automatically
#AIRGENT_MEMORY_AUTO_EXTRACT=1
# Importance halves every N days without access (0 = off)
#AIRGENT_MEMORY_DECAY_DAYS=0
# Letta-style always-in-context core memory blocks
#AIRGENT_MEMORY_CORE_BLOCKS=1
# Skip storing near-duplicate memories
#AIRGENT_MEMORY_DEDUP=1

# Observability: persist per-run trace events (query via store/API)
#AIRGENT_TRACING=1
